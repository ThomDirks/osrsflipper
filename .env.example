# Beschreibender User-Agent für die OSRS Wiki API (Pflicht laut API-Doku).
# Bitte eine Kontaktmöglichkeit (E-Mail oder Discord) eintragen.
WIKI_USER_AGENT="osrs-ge-flipper - contact: you@example.com"

# Datenquelle: "wiki" (Standard, echte Daten) oder "fixtures" (synthetische Testdaten, nur für Tests!)
MARKET_DATA_SOURCE=wiki

# Rate-Limit der eigenen API-Routen (Anfragen pro Minute und IP)
API_RATE_LIMIT_PER_MINUTE=120
